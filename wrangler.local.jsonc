{
  "name": "org-brain-api-local",
  "main": "cloudflare/index.ts",
  "compatibility_date": "2026-09-10",
  "ai": {
    "binding": "AI",
    "remote": true
  },
  "d1_databases": [
    {
      "binding": "DB"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "INVESTIGATIONS",
        "class_name": "InvestigationStateObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["InvestigationStateObject"]
    }
  ],
  "workflows": [
    {
      "name": "org-brain-investigation-local",
      "binding": "INVESTIGATION_WORKFLOW",
      "class_name": "InvestigationWorkflow"
    }
  ],
  "vars": {
    "AI_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    "EMBEDDING_MODEL": "@cf/baai/bge-base-en-v1.5",
    "AI_GATEWAY_ID": "default",
    "ALLOWED_ORIGIN": "http://localhost:3000",
    "MEMORY_MODE": "local-d1"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
