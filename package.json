{
  "name": "next-app",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "cf:types": "yarn dlx wrangler@latest types",
    "cf:dev": "yarn dlx wrangler@latest dev",
    "cf:deploy": "yarn cf:memory:setup && yarn dlx wrangler@latest deploy",
    "cf:d1:local": "yarn dlx wrangler@latest d1 migrations apply DB --local",
    "cf:d1:remote": "yarn dlx wrangler@latest d1 migrations apply DB --remote",
    "cf:memory:setup": "node scripts/setup-memory.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
